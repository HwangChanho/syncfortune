{
  // SyncFortune — TypeScript 설정 (L1 엔진·해석·픽스처 타입체크용)
  // 실행은 tsx, 빌드 산출은 없음(noEmit). RN/Expo 앱 빌드 설정은 ui/ 도입 시 별도.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",   // 확장자 없는 import 허용 (spec/chart 등)
    "strict": true,                  // 골든 픽스처 정합을 엄격 검증
    "esModuleInterop": true,
    "skipLibCheck": true,            // 외부(만세력/iztro) 타입 정의 이슈 무시
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "noEmit": true,
    // ★미사용 import·지역변수를 **컴파일러가** 잡는다(daniel 2026-08-02 "noUnusedLocals 켜서 진행해").
    //   왜 컴파일러인가: 정규식 코드모드로 지우려다 헤더를 덮어써 58개 파일을 망가뜨렸다.
    //   무엇이 쓰이는지는 타입 시스템만이 정확히 안다 — 판정도 수정 검증도 tsc 에 맡긴다.
    "noUnusedLocals": true
  },
  "include": ["engine/**/*", "interpretation/**/*", "security/**/*", "spec/**/*"],
  "exclude": ["node_modules"]
}
